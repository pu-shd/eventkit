#!/bin/sh
# Mock curl. Records the call; silent success unless a fixture says otherwise.
: "${AZ_MOCK_LOG:=/tmp/az-mock.log}"
printf '%s %s\n' "curl" "$*" >> "$AZ_MOCK_LOG"
if [ -n "${CURL_MOCK_OUT:-}" ]; then printf '%s' "${CURL_MOCK_OUT}"; fi
if [ -n "${CURL_MOCK_FAIL:-}" ]; then exit 1; fi
exit 0
