<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Access denied — {{ theme.app_title }}</title>
  <style>
    :root { --brand: {{ theme.brand_color }}; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: #f6f6f6;
      color: #1a1a1a;
      margin: 0;
      display: flex;
      min-height: 100vh;
      align-items: center;
      justify-content: center;
    }
    .card {
      background: #fff;
      border-top: 6px solid var(--brand);
      border-radius: 8px;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
      max-width: 28rem;
      padding: 2rem;
      text-align: center;
    }
    .card img { max-height: 3rem; margin-bottom: 1rem; }
    .card h1 { font-size: 1.25rem; margin: 0 0 0.75rem; }
    .card p { color: #444; line-height: 1.5; }
    .card a { color: var(--brand); }
  </style>
</head>
<body>
  <div class="card">
    {% if theme.logo_url %}<img src="{{ theme.logo_url }}" alt="{{ theme.app_title }}">{% endif %}
    <h1>Access denied</h1>
    <p>
      <strong>{{ email }}</strong> signed in successfully, but is not on the
      access list for <strong>{{ theme.app_title }}</strong>.
    </p>
    {% if theme.support_contact %}
    <p>Need access? Contact <a href="mailto:{{ theme.support_contact }}">{{ theme.support_contact }}</a>.</p>
    {% endif %}
    <p><a href="{{ theme.logout_url }}">Sign out</a> and try a different account.</p>
  </div>
</body>
</html>
