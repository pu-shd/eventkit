{
  "$description": "Brand-neutral base tokens for the eventkit UI kit (W3C Design Tokens draft format). This file is the source of truth for the numeric/color values in tokens.css and fonts.css — it is not read at runtime by eventkit.ui, but tests/unit/ui/test_ui_packaging.py cross-checks the two so they cannot silently drift. A patch release may edit both files together without touching Python.",
  "color": {
    "white": { "$type": "color", "$value": "#ffffff" },
    "neutral": {
      "5": { "$type": "color", "$value": "#f7f7f8" },
      "10": { "$type": "color", "$value": "#eceded" },
      "40": { "$type": "color", "$value": "#b3b6ba" },
      "60": { "$type": "color", "$value": "#7d8186" },
      "85": { "$type": "color", "$value": "#35383c" },
      "90": { "$type": "color", "$value": "#24262a" },
      "100": { "$type": "color", "$value": "#16171a" }
    },
    "brand": {
      "$description": "Brand-neutral grayscale placeholder ramp. A theme.css (themes/<id>/theme.css) or a per-event render_theme_vars() layer overrides these four with the real brand color's OKLCH-derived ramp.",
      "10": { "$type": "color", "$value": "#f2f2f2" },
      "70": { "$type": "color", "$value": "#6b6b6b" },
      "80": { "$type": "color", "$value": "#4d4d4d" },
      "90": { "$type": "color", "$value": "#333333" }
    },
    "action": {
      "$description": "Aliases of color.brand, kept as separate semantic names so buttons/links can be retargeted independently of decorative brand usage without a second override layer.",
      "70": { "$type": "color", "$value": "{color.brand.70}" },
      "80": { "$type": "color", "$value": "{color.brand.80}" }
    },
    "focus-outline": {
      "$type": "color",
      "$value": "#2f6fed",
      "$description": "Deliberately not brand-derived: a focus ring must stay visually distinct from brand accents (which are also used for hover/active states) at any brand_color."
    }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["Source Serif Pro", "Georgia", "Times New Roman", "serif"] },
      "label": { "$type": "fontFamily", "$value": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"] }
    },
    "size": {
      "xs": { "$type": "dimension", "$value": "0.75rem" },
      "sm": { "$type": "dimension", "$value": "0.875rem" },
      "h3": { "$type": "dimension", "$value": "1.5rem" },
      "h1-sm": { "$type": "dimension", "$value": "2rem" },
      "h1": { "$type": "dimension", "$value": "2.75rem" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": "0" },
    "sm": { "$type": "dimension", "$value": "4px" },
    "md": { "$type": "dimension", "$value": "8px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "0.25rem" },
    "2": { "$type": "dimension", "$value": "0.5rem" },
    "3": { "$type": "dimension", "$value": "0.75rem" },
    "4": { "$type": "dimension", "$value": "1rem" },
    "5": { "$type": "dimension", "$value": "1.25rem" },
    "6": { "$type": "dimension", "$value": "1.5rem" },
    "8": { "$type": "dimension", "$value": "2rem" },
    "10": { "$type": "dimension", "$value": "2.5rem" },
    "12": { "$type": "dimension", "$value": "3rem" },
    "16": { "$type": "dimension", "$value": "4rem" }
  },
  "container": {
    "gutter": { "$type": "dimension", "$value": "1.5rem" },
    "max": { "$type": "dimension", "$value": "1200px" }
  },
  "border": {
    "footer-accent": { "$type": "shadow", "$value": "4px solid {color.brand.70}" }
  }
}
